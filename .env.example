# Public: safe to expose to the browser. Find these in Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_ or commit real values.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_SETUP_CODE=

# Public application origin (no trailing slash), used for deployment configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
